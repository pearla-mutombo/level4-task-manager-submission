# Level 4 Task Manager - Backend Environment Example
# Copy this file to .env and replace the placeholders with your own settings.
# Never commit your actual .env file or private credentials.

# React frontend address
FRONTEND_ORIGIN=http://127.0.0.1:5173

# PostgreSQL development database
DATABASE_URL=postgresql+psycopg://YOUR_MAC_USERNAME@127.0.0.1:5432/level4_task_manager_dev

# Separate PostgreSQL database for automated tests
TEST_DATABASE_URL=postgresql+psycopg://YOUR_MAC_USERNAME@127.0.0.1:5432/level4_week2_test

# Supabase Authentication - added on Day 09
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

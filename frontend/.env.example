# Level 4 Task Manager - Frontend Environment Example
# Copy this file to .env.local and replace the placeholders.
# Vite environment variables are visible in the browser.
# Never include private credentials or Supabase secret/service-role keys.

# Flask backend API
VITE_API_BASE_URL=http://127.0.0.1:5001/api

# Supabase Authentication - added on Day 09
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
